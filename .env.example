# Frontend — Expo
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IP o hostname del backend (sin http://, sin puerto)
EXPO_PUBLIC_API_HOST=localhost
# URL completa para producción (opcional)
EXPO_PUBLIC_API_URL=https://your-api.example.com

# Cloudinary (para subir foto de perfil — opcional)
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=comprasur_avatars
